<jasperReport name="Informe_Ventas" language="java" pageWidth="842" pageHeight="595" orientation="Landscape" columnWidth="802" leftMargin="20" rightMargin="20" topMargin="20" bottomMargin="20" uuid="2b59da3b-e3a6-4f59-b094-86eb23db6eb2">
	<property name="com.jaspersoft.studio.data.defaultdataadapter" value="New Data Adapter (2)"/>
	<property name="com.jaspersoft.studio.data.sql.tables" value=""/>
	<query language="sql"><![CDATA[SELECT 
    a.id AS id_alquiler,
    c.nombre AS nombre_cliente,
    c.apellido AS apellido_cliente,
    v.marca AS marca_vehiculo,
    v.modelo AS modelo_vehiculo,
    v.año AS año_vehiculo,
    v.tipo AS tipo_vehiculo,
    a.fecha_inicio,
    a.fecha_fin,
    DATEDIFF(a.fecha_fin, a.fecha_inicio) AS dias_alquiler,
    v.precio_dia,
    a.total
FROM alquileres a
JOIN clientes c ON a.id_cliente = c.id
JOIN vehiculos v ON a.id_vehiculo = v.id
ORDER BY a.fecha_inicio DESC
]]></query>
